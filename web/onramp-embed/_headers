# Response headers for onramp.takumipay.xyz (spec §4.5.1). Cloudflare Pages
# / Netlify `_headers` format; translate 1:1 for any other host.
# frame-ancestors 'none': only the app loads this page, top-level.
# Widget + API origins for both environments (spec §2.3); confirm the
# current list with the provider before production (README of the kit).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self' data:; frame-src https://onramp.arc.io https://onramp-sandbox.arc.io; connect-src https://onramp.arc.io https://onramp-sandbox.arc.io https://api.circle.com https://api-test.circle.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin
  Permissions-Policy: camera=(self "https://onramp.arc.io" "https://onramp-sandbox.arc.io"), payment=(self "https://onramp.arc.io" "https://onramp-sandbox.arc.io"), geolocation=(), microphone=()
  Cache-Control: no-cache
/v1/*.js
  Cache-Control: public, max-age=31536000, immutable
